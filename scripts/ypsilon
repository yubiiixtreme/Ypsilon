#!/usr/bin/env bash
# ypsilon CLI — explicit actions only; nothing runs on its own except
# `ypsilon start`, which the Hyprland config calls once per session.
# Thin dispatcher: the commands live in scripts/cli/*.sh (sourced) and scripts/*.py.
ROOT=${YPSILON_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}
cmd=${1:-help}

for m in core session display toggles capture menu; do
  # shellcheck source=/dev/null
  . "$ROOT/scripts/cli/$m.sh"
done

usage() {
  local text
  text=$(cat <<'USAGE'  # quoted: help text must never execute anything
ypsilon — our DE CLI (v0.5)

Display & quick toggles
  ypsilon status [--json|--watch [S]]  one-glance card: resources, screen, sound, session
  ypsilon menu [--list]             quick toggle menu (fzf in a terminal, fuzzel in the session: SUPER+ALT+M)
  ypsilon gamma [status|get]        current screen gamma (100 = neutral)
  ypsilon gamma lower|raise [STEP]  step it down/up (config display.gammaStep; SUPER+ALT+- / =)
  ypsilon gamma set N|+N|-N         20..150 — below 100 dims past the backlight minimum, above brightens
  ypsilon gamma toggle|reset        100 <-> display.gammaDim (SUPER+ALT+G) · back to 100 (SUPER+ALT+0)
  ypsilon gamma fade N [SECS]       glide to N over SECS (default 60) — e.g. wind down the evening
  ypsilon gamma tune                interactive: arrows/hjkl adjust, 0 reset, d dim, q done
  ypsilon nightlight [on|off|toggle|status] warm screen (config display.nightTemp)
  ypsilon gamemode [on|off|toggle|status]   kill animations/blur/gaps for max perf
  ypsilon caffeine [on|off|toggle|status]   keep the screen awake (pauses hypridle)
  ypsilon layout [dwindle|master|toggle]    switch tiling layout
  ypsilon pip                       picture-in-picture: float + pin the window bottom-right (again: tile)

Look
  ypsilon theme list                list themes
  ypsilon theme set NAME [--apply]  regenerate files (+ live-apply with --apply)
  ypsilon theme auto [--light] [--apply]  theme generated from the current wallpaper
  ypsilon gen                       regenerate themes + wallpapers (repo files only)
  ypsilon wallpaper {list|files|status|set NAME|PATH|next|restore}

Capture & tools
  ypsilon shot {select|full|window|delay|annotate}  screenshot -> ~/Pictures/Screenshots + clipboard
                                    (select: click a window to take it whole, or drag an area)
  ypsilon ocr                       text from a screen region -> clipboard (tesseract; YPSILON_OCR_LANG)
  ypsilon record {select|full|stop|toggle}
  ypsilon pick                      color picker -> clipboard (hyprpicker)
  ypsilon calc EXPR                 safe calculator: functions, constants, factorial (try: sqrt(16), sin(30), 5!)
  ypsilon pw [LEN] [--no-symbols]   strong password -> stdout (+ clipboard with wl-copy)
  ypsilon clip                      clipboard history picker (cliphist + fuzzel)

Shell
  ypsilon toggle NAME               toggle a shell window: launcher control dashboard notif-center
                                    wallpapers cheatsheet overview power
  ypsilon settings [PAGE]           open the control panel (general appearance bar desktop input network
                                    bluetooth sound power updates plugins about)
  ypsilon keys                      keybind cheat-sheet (shell popup)
  ypsilon osd {volume|brightness|gamma}  show OSD
  ypsilon lock                      hyprlock with the Ypsilon config
  ypsilon terminal                  open your terminal (Settings → Apps, else the first one installed)
  ypsilon browser                   open your default web browser
  ypsilon term CMD...               run CMD in your terminal (config: terminal)
  ypsilon plugin [list|enable ID|disable ID|new ID|run ID CMD|rescan]   plugins

Config & session
  ypsilon config [path|edit|init|check]   user config (~/.config/ypsilon/config.json)
  ypsilon reload                    check config, re-render it, reload Hyprland + shell css, report health
  ypsilon apply                     apply config.json hypr/input/idle settings now
  ypsilon start                     session bring-up (idempotent): wallpaper, idle, polkit, clipboard, shell
  ypsilon try                       preview in a NESTED Hyprland window (does not touch your session)
  ypsilon bar                       run the shell in the foreground (dev)
  ypsilon restart                   restart the shell (after config changes like bar position)
  ypsilon stop                      stop the shell and every daemon that start launched
  ypsilon updates run               upgrade the system in a terminal (pacman/AUR + flatpak)
  ypsilon self-update               pull Ypsilon (fast-forward only), regenerate, re-check

Health
  ypsilon health                    which shell components are running / failed
  ypsilon logs [--prev]             follow the shell log (--prev: log of the last crash)
  ypsilon check                     validate everything (hypr conf, css, types, icons, tests)
  ypsilon doctor                    read-only environment report with fix hints
  ypsilon report [FILE]             bundle doctor + checks + logs into one file for bug reports
USAGE
)
  if ui; then
    # headings bold in the theme's primary color, descriptions dimmed
    awk 'NR == 1 { printf "\033[1;34m✦\033[0m \033[1m%s\033[0m\n", $0; next }
         /^[A-Z]/ { printf "\n\033[1;34m▍\033[0m\033[1m%s\033[0m\n", $0; next }
         /^$/ { next }
         /^  ypsilon / { r = substr($0, 3); if (match(r, /  +/)) printf "  %s\033[2m%s\033[0m\n", substr(r, 1, RSTART - 1), substr(r, RSTART); else print; next }
         { printf "\033[2m%s\033[0m\n", $0 }' <<< "$text"
  else
    printf '%s\n' "$text"
  fi
}

case "$cmd" in
  help|--help|-h) usage;;
  status) shift; exec python3 "$ROOT/scripts/status.py" "$@";;
  menu) shift; cmd_menu "$@";;
  gamma) shift; cmd_gamma "$@";;
  nightlight) cmd_nightlight "${2:-toggle}";;
  gamemode) cmd_gamemode "${2:-toggle}";;
  caffeine) cmd_caffeine "${2:-toggle}";;
  layout) cmd_layout "${2:-toggle}";;
  pip) cmd_pip;;
  theme)
    case "${2:-list}" in
      list) python3 "$ROOT/scripts/gen-theme.py" --list;;
      set)
        name="${3:?usage: ypsilon theme set NAME [--apply]}"
        python3 "$ROOT/scripts/gen-theme.py" --theme "$name" || exit 1
        if [ "${4:-}" = "--apply" ]; then
          # the running shell watches the generated css and re-applies on its own
          hyprctl reload >/dev/null && ags request -i ypsilon reload-css >/dev/null 2>&1
          echo "theme applied: $name"
        else
          echo "files regenerated. apply with: ypsilon theme set $name --apply"
        fi;;
      auto)
        shift 2
        img=$("$ROOT/scripts/wallpaper.sh" status | sed 's/^current: //')
        [ -f "$img" ] || { echo "no current wallpaper file (set one first: ypsilon wallpaper set ...)"; exit 1; }
        light=""; apply=""
        for a in "$@"; do case $a in --light) light=--light;; --apply) apply=--apply;; esac; done
        python3 "$ROOT/scripts/palette.py" "$img" --name ypsilon-auto $light || exit 1
        exec "$0" theme set ypsilon-auto $apply;;
      *) echo "usage: ypsilon theme {list|set NAME [--apply]|auto [--light] [--apply]}"; exit 1;;
    esac;;
  gen) python3 "$ROOT/scripts/gen-theme.py" && python3 "$ROOT/scripts/make-wallpaper.py" && echo "gen OK";;
  wallpaper) shift; "$ROOT/scripts/wallpaper.sh" "$@";;
  shot) cmd_shot "${2:-select}";;
  record) shift; "$ROOT/scripts/record.sh" "$@";;
  pick) cmd_pick;;
  ocr) cmd_ocr;;
  calc)
    shift
    [ $# -gt 0 ] || { echo "usage: ypsilon calc EXPR  (e.g. ypsilon calc 'sqrt(16)+2*3')"; exit 1; }
    python3 "$ROOT/scripts/calc.py" "$*" || exit 1;;
  pw)
    shift
    len=20; sym=1
    for a in "$@"; do
      case "$a" in
        --no-symbols|--plain) sym=0;;
        --symbols) sym=1;;
        [0-9]*) len="$a";;
        *) echo "usage: ypsilon pw [LEN] [--no-symbols]"; exit 1;;
      esac
    done
    case "$len" in ''|*[!0-9]*) echo "length must be a number 4..128"; exit 1;; esac
    [ "$len" -ge 4 ] && [ "$len" -le 128 ] || { echo "length must be 4..128"; exit 1; }
    pw=$(python3 - "$len" "$sym" <<'PY' || exit 1
import secrets, sys
n = int(sys.argv[1]); symbols = sys.argv[2] == "1"
pool = "abcdefghjkmnpqrstuvwxyzABCDEFGHJKMNPQRSTUVWXYZ23456789" + ("!@#$%^&*+-=?" if symbols else "")
print("".join(secrets.choice(pool) for _ in range(n)))
PY
    )
    printf '%s\n' "$pw"
    if have wl-copy && [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
      if have timeout; then printf '%s' "$pw" | timeout 1 wl-copy 2>/dev/null && echo "(copied to clipboard)" || true
      else printf '%s' "$pw" | wl-copy 2>/dev/null && echo "(copied to clipboard)" || true; fi
    fi;;
  config)
    case "${2:-path}" in
      path) echo "$CFG";;
      init) mkdir -p "$(dirname "$CFG")"; [ -f "$CFG" ] && echo "exists: $CFG" || { cp "$ROOT/config.example.json" "$CFG" && echo "created: $CFG"; };;
      edit) "$0" config init >/dev/null; "${EDITOR:-nano}" "$CFG"; "$0" config check;;
      check) NODE_NO_WARNINGS=1 node "$ROOT/scripts/config-check.mjs" "$CFG";;
      *) echo "usage: ypsilon config [path|init|edit|check]"; exit 1;;
    esac;;
  keys) ags toggle -i ypsilon ypsilon-cheatsheet;;
  clip) cliphist list | fuzzel --dmenu | cliphist decode | wl-copy;;
  lock) ensure_generated; pidof hyprlock >/dev/null || hyprlock -c "$ROOT/hypr/generated/hyprlock.conf";;
  toggle) n="${2:?usage: ypsilon toggle NAME (launcher, control, dashboard, wallpapers, ...)}"; ags toggle -i ypsilon "ypsilon-${n#ypsilon-}";;
  osd) ags request -i ypsilon osd "${2:-volume}";;
  reload) cmd_reload;;
  start) cmd_start;;
  try) cmd_try;;
  bar) ensure_generated; YPSILON_ROOT="$ROOT" exec ags run "$ROOT/shell/app.tsx";;
  logs)
    f=${XDG_RUNTIME_DIR:-/tmp}/ypsilon/shell.log
    if [ "${2:-}" = "--prev" ]; then f=$f.prev; fi
    if [ -f "$f" ]; then exec tail -n 200 -f "$f"; else echo "no shell log yet ($f)"; fi;;
  health) ags request -i ypsilon health 2>/dev/null || echo "shell not running (ypsilon start)";;
  restart) ags quit -i ypsilon >/dev/null 2>&1; stop_daemons shell >/dev/null; sleep 0.3; cmd_start; echo "shell restarted";;
  term) shift; term "$@";;
  terminal)
    t=$(pick_terminal)
    [ -n "$t" ] || { have notify-send && notify-send -a Ypsilon "No terminal found" "Install foot or kitty, or set one in Settings → Apps"; exit 1; }
    read -ra argv <<< "$t"; exec "${argv[@]}";;
  browser)
    # the browser you picked as default (xdg-settings), else the first one installed
    d=$(xdg-settings get default-web-browser 2>/dev/null || true)
    if [ -n "$d" ] && have gtk-launch && gtk-launch "$d" >/dev/null 2>&1; then exit 0; fi
    for b in firefox chromium google-chrome-stable brave zen-browser librewolf vivaldi-stable epiphany; do have "$b" && exec "$b"; done
    have notify-send && notify-send -a Ypsilon "No web browser found" "Install one, e.g. firefox or chromium"; exit 1;;
  settings) ags request -i ypsilon settings "${2:-}" >/dev/null 2>&1 || echo "shell not running (ypsilon start)";;
  plugin|plugins)
    case "${2:-list}" in
      run) shift 2; ags request -i ypsilon plugin "$@" 2>/dev/null || echo "shell not running";;
      rescan) ags request -i ypsilon plugins-rescan 2>/dev/null || echo "shell not running";;
      *) shift; python3 "$ROOT/scripts/plugin.py" "$@";;
    esac;;
  updates)
    case "${2:-run}" in
      run)
        aur=""; for h in paru yay; do have "$h" && { aur=$h; break; }; done
        if [ -n "$aur" ]; then cmd="$aur -Syu"; else cmd="sudo pacman -Syu"; fi
        have flatpak && cmd="$cmd && flatpak update"
        term "echo '== Ypsilon: system update =='; $cmd";;
      *) echo "usage: ypsilon updates run   (the shell's Updates page shows what's pending)"; exit 1;;
    esac;;
  self-update)
    git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git checkout"; exit 1; }
    if [ -z "$(git -C "$ROOT" remote)" ]; then echo "local repo without a remote - nothing to pull"; exit 0; fi
    if [ -n "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ]; then echo "you have local changes - commit or stash them first"; exit 1; fi
    git -C "$ROOT" pull --ff-only && python3 "$ROOT/scripts/gen-theme.py" >/dev/null && "$ROOT/scripts/check.sh" \
      && { ags request -i ypsilon reload-css >/dev/null 2>&1; echo "updated - run 'ypsilon restart' to load the new shell"; };;
  apply)
    # config.json -> hypr/generated/{user,hypridle}.conf, then make Hyprland + hypridle use it
    python3 "$ROOT/scripts/gen-theme.py" --paths-only >/dev/null || { echo "gen failed"; exit 1; }
    hyprctl reload >/dev/null 2>&1 || true
    if [ -f "${XDG_RUNTIME_DIR:-/tmp}/ypsilon/${WAYLAND_DISPLAY:-wl}.hypridle.pid" ]; then
      stop_daemons hypridle >/dev/null; once hypridle hypridle -c "$ROOT/hypr/generated/hypridle.conf"
    fi
    echo "applied";;
  stop) ags quit -i ypsilon >/dev/null 2>&1; stop_daemons;;
  check) exec "$ROOT/scripts/check.sh";;
  doctor) cmd_doctor;;
  report)
    out=${2:-$HOME/ypsilon-report-$(date +%Y%m%d_%H%M%S).txt}; _ui=0   # plain text in the file
    {
      echo "# Ypsilon report $(date -Is)"; echo "root: $ROOT"; git -C "$ROOT" log -1 --format='commit: %h %s' 2>/dev/null
      uname -sr; echo; cmd_doctor; echo; echo "## status"; python3 "$ROOT/scripts/status.py" 2>&1
      echo; echo "## check"; "$ROOT/scripts/check.sh" 2>&1
      echo; echo "## config"; "$0" config check 2>&1
      echo; echo "## shell health"; ags request -i ypsilon health 2>&1
      for f in shell.log shell.log.prev; do echo; echo "## $f (last 80 lines)"; tail -n 80 "${XDG_RUNTIME_DIR:-/tmp}/ypsilon/$f" 2>/dev/null || echo "(none)"; done
    } > "$out" 2>&1
    echo "report written: $out  (attach it to a bug report)";;
  *) echo "unknown: $cmd"; usage; exit 1;;
esac
